{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webtag.alpenl.com/mobile/share-payloads.schema.json",
  "title": "WebTag Share payload fixtures",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 200,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "httpUrl": {
      "type": "string",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s]+$",
      "maxLength": 2048
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "structured_urls",
        "plain_text",
        "expected_candidates",
        "expected_outcome",
        "requires_user_selection"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,96}$"
        },
        "source": {
          "type": "string",
          "enum": [
            "structured_url",
            "plain_text",
            "mixed",
            "clip_data",
            "ios_item_provider",
            "android_intent",
            "unsupported_scheme",
            "empty"
          ]
        },
        "structured_urls": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "plain_text": {
          "type": ["string", "null"],
          "maxLength": 16384
        },
        "expected_candidates": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/httpUrl"
          }
        },
        "expected_outcome": {
          "type": "string",
          "enum": ["submit", "choose", "reject"]
        },
        "requires_user_selection": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected_outcome": {"const": "choose"}
            },
            "required": ["expected_outcome"]
          },
          "then": {
            "properties": {
              "requires_user_selection": {"const": true}
            }
          }
        },
        {
          "if": {
            "properties": {
              "expected_outcome": {"enum": ["submit", "reject"]}
            },
            "required": ["expected_outcome"]
          },
          "then": {
            "properties": {
              "requires_user_selection": {"const": false}
            }
          }
        }
      ]
    }
  }
}
